# Copiar a .env (ignorado por git) y rellenar. Nunca commitear .env.

# Zona horaria del stack (fechas del plan y del ciclo semanal)
TZ=America/Guayaquil

# Postgres: superusuario y el usuario de la base skylab.
# Generar cada una con: python -c "import secrets; print(secrets.token_hex(24))"
# Solo se aplican al crear el volumen por primera vez.
POSTGRES_PASSWORD=
SKYLAB_DB_PASSWORD=

# LLM
ANTHROPIC_API_KEY=

# Token que exigen la API y el servicio de Garmin en cada llamada
# (cabecera "Authorization: Bearer <token>").
#   python -c "import secrets; print(secrets.token_hex(32))"
SKYLAB_API_TOKEN=
