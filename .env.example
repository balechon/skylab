# Copiar a .env (ignorado por git) y rellenar. Nunca commitear .env.

# Zona horaria del stack (fechas del plan y del ciclo semanal)
TZ=America/Guayaquil

# Postgres: superusuario y el usuario de la base skylab.
# Generar cada una con: python -c "import secrets; print(secrets.token_hex(24))"
# Solo se aplican al crear el volumen por primera vez.
POSTGRES_PASSWORD=
SKYLAB_DB_PASSWORD=

# LLM
ANTHROPIC_API_KEY=

# Token que exigen la API y el servicio de Garmin en cada llamada
# (cabecera "Authorization: Bearer <token>").
#   python -c "import secrets; print(secrets.token_hex(32))"
SKYLAB_API_TOKEN=

# Notion (servicio skylab-notion). El token NO va aquí: va en
# secrets/notion_token.txt. Aquí solo los ids de las bases (data sources),
# que no son secretos.
NOTION_DS_ATLETA=
NOTION_DS_SEMANAS=
NOTION_DS_ENTRENAMIENTOS=
# Página Monitor (opcional)
NOTION_DS_RESUMEN=
NOTION_DS_EJECUCIONES=
NOTION_DS_CARGA=
# 1 = modo simulación: lee Notion y la API pero no escribe nada
NOTION_SIMULACION=
